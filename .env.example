# Copy this file to .env and fill in real values. .env is gitignored - never
# commit real API keys.

# ==============================================================================
# 1. LLM Backend Configuration (OpenAI-compatible endpoint, Ollama, or Gateway)
# ==============================================================================
# Base URL for the OpenAI-compatible LLM endpoint.
# Defaults to local Ollama (http://localhost:11434/v1) if not set.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# The model identifier to use (e.g. qwen2.5-coder:32b, llama3.3:70b, gpt-4o).
LOCAL_LLM_MODEL=qwen2.5-coder:32b

# Optional API key for hosted gateways / OpenRouter / authenticated endpoints.
# Set to 'not-needed' or leave blank for local unauthenticated Ollama.
LLM_GATEWAY_API_KEY=

# ==============================================================================
# 2. OpenFOAM Docker & Solver Execution Settings
# ==============================================================================
# Docker container image providing OpenFOAM v13 binaries (foamRun, blockMesh, checkMesh).
# Default: microfluidica/openfoam:13
FOAM_DOCKER_IMAGE=microfluidica/openfoam:13

# Wall-clock timeout (in seconds) for each Docker execution step (dry run & solver ladder).
# Default: 600
FOAM_VALIDATION_TIMEOUT=600

# Number of MPI ranks for parallel solver execution (mpirun -np N foamRun -parallel).
# Default: 1 (serial). Set to 4, 8, etc., to accelerate large 3D meshes across host CPU cores.
FOAM_VALIDATION_PROCS=1

# ==============================================================================
# 3. Mesh Quality & Diagnostic Checks
# ==============================================================================
# Enable exhaustive checkMesh flags (-allTopology -allGeometry -meshQuality).
# Default: 0 (standard fast checkMesh). Set to 1 for deep geometry/topology inspection.
FOAM_CHECKMESH_ALL=0
