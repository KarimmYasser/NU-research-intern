# Scratch space — downloaded reference material, cloned repos, one-off script output.
# See CLAUDE.md for the temp/ convention. Not meant to be version-controlled.
temp/

# Local settings and secrets - never commit
.env
.claude/settings.local.json

# Generated simulation cases (the assistant's working directory).
# The folder itself is kept via workspace/.gitkeep.
workspace/*
!workspace/.gitkeep

# Setup/launch/diagnostic logs written by setup.sh, start.sh, check.sh
.harness/

# Pi package installs and settings backups (the adapter entry itself is committed)
.pi/npm/
.pi/git/
.pi/settings.json.bak.*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# Logs & temporary files
*.log
*.tmp
*.bak
*.foam

# Local IDE & Language Server Configs
.vscode/
pyrightconfig.json

