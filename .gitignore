# Scratch space — downloaded reference material, cloned repos, one-off script output.
# See CLAUDE.md for the temp/ convention. Not meant to be version-controlled.
temp/

# Local Claude Code settings (machine-specific)
.claude/settings.local.json

# Secrets (API keys, endpoints) - never commit
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
Lib/*
Scripts/*
